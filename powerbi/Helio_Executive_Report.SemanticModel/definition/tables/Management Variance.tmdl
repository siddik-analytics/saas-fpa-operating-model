		sourceColumn: Favourable / Unfavourable

		annotation SummarizationSetBy = Automatic

	column 'Variance Rank'
		dataType: int64
		isHidden
		formatString: #,##0
		lineageTag: 1d254a4d-dd57-55d8-9daa-1ac5f2e74c6b
