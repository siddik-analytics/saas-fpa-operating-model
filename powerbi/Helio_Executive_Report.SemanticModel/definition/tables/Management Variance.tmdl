		annotation SummarizationSetBy = Automatic

	column Material
		dataType: boolean
		isHidden
		lineageTag: 73ae085c-5879-5656-8f4d-59174b82cebb
		summarizeBy: none
		sourceColumn: Material

		annotation SummarizationSetBy = Automatic

	partition 'Management Variance' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RepoRoot & "/data/marts/fct_management_variance.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Headers, {"metric", "metric_label", "period", "unit", "budget_amount", "base_amount", "variance", "favorable_unfavorable", "rank_abs_variance", "materiality_flag"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"metric", type text}, {"metric_label", type text}, {"period", type text}, {"unit", type text}, {"budget_amount", type number}, {"base_amount", type number}, {"variance", type number}, {"favorable_unfavorable", type text}, {"rank_abs_variance", Int64.Type}, {"materiality_flag", type logical}}),
				    Renamed = Table.RenameColumns(Typed, {{"metric", "Metric"}, {"metric_label", "Metric Label"}, {"period", "Period"}, {"unit", "Unit"}, {"budget_amount", "Budget Amount"}, {"base_amount", "Base Amount"}, {"variance", "Variance"}, {"favorable_unfavorable", "Favourable / Unfavourable"}, {"rank_abs_variance", "Variance Rank"}, {"materiality_flag", "Material"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
