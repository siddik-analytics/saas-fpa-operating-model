/// The normalised, ranked FY2026 Budget-vs-Base scorecard. Pages 1 and 4. Disconnected from
/// Date: every row is already a stated FY2026 or Dec-2026 figure.
table 'Management Variance'
	lineageTag: 40fe65ac-1a38-57e2-89d1-b1a11644e455

	/// FY2026 Board-Approved Budget for the metric in context.
	measure Budget =
			VAR Amount = SUM('Management Variance'[Budget Amount])
			RETURN
			    -- Basis points to a ratio, so a level reads 74.1% rather than 7,407 bps.
			    IF(
			        SELECTEDVALUE('Management Variance'[Unit]) = "bps",
			        DIVIDE(Amount, 10000),
			        Amount
			    )
		displayFolder: 08 Budget & Bridge
		lineageTag: c486cf18-1110-51f7-9f08-92574e4f57a9

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Management Variance'[Unit]),
				    "usd", "$#,##0;($#,##0);$0",
				    "bps", "0.0%",
				    "pct", "0.0%",
				    "fte", "#,##0.0",
				    "#,##0"
				)

	/// Independent Base reforecast for the metric in context.
	measure 'Base Reforecast' =
			VAR Amount = SUM('Management Variance'[Base Amount])
			RETURN
			    -- Basis points to a ratio, so a level reads 74.1% rather than 7,407 bps.
			    IF(
			        SELECTEDVALUE('Management Variance'[Unit]) = "bps",
			        DIVIDE(Amount, 10000),
			        Amount
			    )
		displayFolder: 08 Budget & Bridge
		lineageTag: b4474355-c281-5406-885a-56526f032e47

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Management Variance'[Unit]),
				    "usd", "$#,##0;($#,##0);$0",
				    "bps", "0.0%",
				    "pct", "0.0%",
				    "fte", "#,##0.0",
				    "#,##0"
				)

	/// Base less Budget, signed. Favourability is not implied by the sign: it comes from the
	/// centralised Phase 7 metric polarity.
	measure 'Variance vs Budget' =
			SUM('Management Variance'[Variance])
		displayFolder: 08 Budget & Bridge
		lineageTag: 45f7c1a4-5b2b-5229-94af-77bf6f8b024c

		formatStringDefinition =
				SWITCH(
				    SELECTEDVALUE('Management Variance'[Unit]),
				    "usd", "+$#,##0;($#,##0);$0",
				    "bps", "+#,##0 ""bps"";-#,##0 ""bps"";0 ""bps""",
				    "pct", "+0.0%;-0.0%;0.0%",
				    "fte", "+#,##0.0;-#,##0.0;0.0",
				    "+#,##0;-#,##0;0"
				)

	/// Variance as a percentage of Budget, for USD rows only.
	measure 'Variance vs Budget %' =
			-- Only defined where the row is a dollar metric. Basis points and FTE rows have
			-- no meaningful percentage against their own base.
			IF(
			    SELECTEDVALUE('Management Variance'[Unit]) = "usd",
			    DIVIDE([Variance vs Budget], [Budget])
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 08 Budget & Bridge
		lineageTag: cf5dca15-1857-57ec-912e-3f60d83bc8a3

	/// Dec-2026 Exit ARR variance to Budget - the headline management number of the whole
	/// reforecast.
	measure 'Exit ARR vs Budget' =
			CALCULATE(
			    SUM('Management Variance'[Variance]),
			    REMOVEFILTERS('Management Variance'),
			    'Management Variance'[Metric] = "exit_arr"
			)
		formatString: +\$#,##0;(\$#,##0);\$0
		displayFolder: 08 Budget & Bridge
		lineageTag: 959a5f7e-d51f-5196-b2bb-254a9e0c8840

	/// Exit ARR variance as a percentage of the Board Budget exit position.
	measure 'Exit ARR vs Budget %' =
			DIVIDE(
			    [Exit ARR vs Budget],
			    CALCULATE(
			        SUM('Management Variance'[Budget Amount]),
			        REMOVEFILTERS('Management Variance'),
			        'Management Variance'[Metric] = "exit_arr"
			    )
			)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 08 Budget & Bridge
		lineageTag: 9ac33301-957e-5a79-a5e2-30e14b524571

	column Metric
		dataType: string
		isHidden
		lineageTag: 9ee18717-7de0-53b0-8263-9cc581bfb478
		summarizeBy: none
		sourceColumn: Metric

		annotation SummarizationSetBy = Automatic

	column 'Metric Label'
