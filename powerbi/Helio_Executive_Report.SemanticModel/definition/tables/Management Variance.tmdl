		sourceColumn: Base Amount

		annotation SummarizationSetBy = Automatic

	column Variance
		dataType: double
		isHidden
		formatString: \$#,##0;(\$#,##0);\$0
		lineageTag: 7eaad34b-9791-542e-9a7a-9f05c939202c
		summarizeBy: none
		sourceColumn: Variance

		annotation SummarizationSetBy = Automatic

	column 'Favourable / Unfavourable'
		dataType: string
		lineageTag: e713e978-53ed-533f-b5d4-711ae92f758d
