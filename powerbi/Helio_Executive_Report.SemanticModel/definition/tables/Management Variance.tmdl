		annotation SummarizationSetBy = Automatic

	column 'Budget Amount'
		dataType: double
		isHidden
		formatString: \$#,##0;(\$#,##0);\$0
		lineageTag: c0de4a6e-cc84-502e-9e85-710520c78fd8
		summarizeBy: none
		sourceColumn: Budget Amount

		annotation SummarizationSetBy = Automatic

	column 'Base Amount'
		dataType: double
		isHidden
		formatString: \$#,##0;(\$#,##0);\$0
		lineageTag: 15754e9d-9c95-5d19-9aca-c011e2ec1b8f
